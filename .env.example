# ---------------------------------------------------------------------------
# pumex-merged-envio
#
# Copy to `.env` and fill in real values. Envio requires the `ENVIO_` prefix on
# anything read at runtime by the indexer or exposed on the hosted service.
# ---------------------------------------------------------------------------

# HyperSync access. Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# ---------------------------------------------------------------------------
# RPC endpoints — one per chain, named `ENVIO_RPC_URL_<chainId>`
#
# Every subtree (analytics, farm, helper, v1, v4) reads this one convention.
# Handler-side `eth_call`s are pinned to the block of the event that triggered
# them, so each endpoint should be an archive node; a pruned node answers from a
# later state instead of failing loudly. Public endpoints are used as
# last-resort fallbacks and are generally rate limited.
# ---------------------------------------------------------------------------

# TAC (239) — analytics + v1.
ENVIO_RPC_URL_239="<TAC-ARCHIVE-RPC>"

# Linea (59144) — helper + v1.
ENVIO_RPC_URL_59144="<LINEA-ARCHIVE-RPC>"

# Plasma (9745) — helper + v1.
ENVIO_RPC_URL_9745="<PLASMA-ARCHIVE-RPC>"

# Injective (1776) — helper + v1 + v4.
ENVIO_RPC_URL_1776="<INJECTIVE-ARCHIVE-RPC>"

# Robinhood (4663) — helper + v1 + v4.
ENVIO_RPC_URL_4663="<ROBINHOOD-ARCHIVE-RPC>"

# Zircuit (48900) — chain is `skip: true` in config.yaml. Supply an endpoint
# that serves full historical logs — see the README.
ENVIO_RPC_URL_48900="<ZIRCUIT-ARCHIVE-RPC>"

# Injective testnet (1439) — chain is `skip: true` in config.yaml. This chain
# syncs over RPC, so the endpoint serves both the sync and the contract reads.
ENVIO_RPC_URL_1439=""
